# Local example only. Never commit real credentials.
# On Replit, use the provisioned DATABASE_URL and workspace/publishing Secrets.
# The server does not load .env automatically; see README for local commands.

# Runtime PostgreSQL connection. Replace this placeholder for local use.
DATABASE_URL="postgresql://local_user:replace_me@127.0.0.1:5432/registrack_local_dev"

# Required only when no Registrar account exists.
# Choose a strong, private password before starting a fresh local database.
REGISTRAR_BOOTSTRAP_PASSWORD="replace_with_a_strong_private_password"

# Optional runtime settings.
PORT=5000
NODE_ENV=development
DISABLE_HMR=false

# Optional, explicit LOCAL setup target; never defaults to DATABASE_URL.
# Only numeric loopback hosts and registrack_local_* / registrack_temp_* names
# are accepted. Setup skips any database that already contains user objects.
LOCAL_DATABASE_URL="postgresql://local_user:replace_me@127.0.0.1:5432/registrack_local_dev"
